{
  "webSearch": {
    "allowedProviders": [
      "exa",
      "tinyfish",
      "firecrawl",
      "duckduckgo"
    ]
  },
  "searchRouting": {
    "providers": [
      "exa",
      "tinyfish",
      "firecrawl",
      "duckduckgo"
    ],
    "fallbackOn": [
      "transient",
      "quota",
      "credential",
      "auth",
      "network",
      "invalid-response"
    ]
  },
  "exaApiKey": "!$HOME/.pi/agent/scripts/get-secret.sh EXA_API_KEY",
  "tinyfishApiKey": "!$HOME/.pi/agent/scripts/get-secret.sh TINYFISH_API_KEY",
  "firecrawlBaseUrl": "https://api.firecrawl.dev",
  "firecrawlApiKey": "!$HOME/.pi/agent/scripts/get-secret.sh FIRECRAWL_API_KEY",
  "firecrawlApiVersion": "v2",
  "firecrawlFreshScrape": false,
  "fetchRouting": {
    "providers": [
      "http",
      "firecrawl",
      "crawl4ai",
      "jina",
      "tinyfish",
      "search1api",
      "querit",
      "kagi",
      "ollama",
      "parallel",
      "brightdata",
      "gemini"
    ],
    "allowRemoteHostedProviders": true
  }
}
